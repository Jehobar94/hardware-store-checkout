HOST=127.0.0.1
PORT=3000

# Supabase connection (never commit the real values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Wompi sandbox (keep private keys only in backend/.env)
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_your-public-key
WOMPI_PRIVATE_KEY=prv_test_your-private-key
